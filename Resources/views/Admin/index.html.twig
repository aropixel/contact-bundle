{% extends '@AropixelAdmin/List/datatable.html.twig' %}

{% block meta_title %} Contacts - Liste des messages {% endblock %}
{% block header_title %}Contacts{% endblock %}

{% block header_breadcrumb %}
    <ul class="breadcrumb breadcrumb-caret position-right">
        <li class="breadcrumb-item"><a href="{{ url('_admin') }}">Accueil</a></li>
        <li class="breadcrumb-item active">Contacts</li>
    </ul>
{% endblock %}


{% block paneldatatable %}

    <table class="table card-table table-vcenter text-nowrap datatable" data-order-column="1" data-order-direction="DESC">
        <thead>
            <tr>
                <th class="date-euro" style="width:200px">Date</th>
                <th>Titre</th>
                <th style="width:200px">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for contact in contacts %}
                <tr>
                    <td style="vertical-align: top; {% if contact.read == false %}background-color: rgba(12,171,168,0.11);{% endif %}">{{ contact.createdAt|datetime('dd/MM/y H:mm') }}</td>
                    <td {% if contact.read == false %}style="background-color: rgba(12,171,168,0.11);" {% endif %}>
                        <strong style="width: 45px; display: inline-block;">De:</strong>{{ contact.nomFrom ? contact.nomFrom ~ ' ' : '' }}&nbsp;&nbsp;&lt;{{ contact.emailFrom }}&gt;<br />
                        <strong style="width: 45px; display: inline-block;">À:</strong>{{ contact.nomTo ? contact.nomTo ~ ' ' : '' }}&nbsp;&nbsp;&lt;{{ contact.emailTo }}&gt;<br />
                        <strong style="width: 45px; display: inline-block;">Objet:</strong>{{ contact.objet }}<br />
                        <div class="m-t-5 text-muted">{{ contact.message | u.truncate(120, false, '...') }}</div>
                    </td>
                    <td class="text-right" {% if contact.read == false %}style="background-color: rgba(12,171,168,0.11);" {% endif %}>
                        <div class="btn-group">
                            <button type="button" class="badge badge-light badge-icon" data-bs-toggle="dropdown" data-boundary="viewport">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" data-bs-popper="static">
                                <a href="{{ path('aropixel_contact_edit', {'id': contact.id}) }}" class="dropdown-item has-icon"><i class="fas fa-edit"></i> Modifier</a>
                                <a data-confirm="Êtes-vous certain(e) de vouloir supprimer ce contact ?" class="delete dropdown-item has-icon text-danger">
                                    <i class="fas fa-trash"></i> Supprimer
                                </a>
                                <form method="post" action="{{ path('aropixel_contact_delete', {'id': contact.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete__contact' ~ contact.id) }}">
                                </form>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}